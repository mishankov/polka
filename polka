#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$root"
set -- --package-path "$root/tools" --configuration "${POLKA_TOOLS_CONFIGURATION:-release}" polka-tool "$@"
if [ -n "${POLKA_SWIFT_BUILD_JOBS:-}" ]; then
  set -- --jobs "$POLKA_SWIFT_BUILD_JOBS" "$@"
fi
exec swift run "$@"
