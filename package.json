{
  "name": "polka",
  "version": "0.1.15",
  "private": true,
  "description": "Приложения и история буфера обмена на полке macOS",
  "author": "Polka contributors",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\" && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "native:build": "swiftc -O native/MediaProbe.swift -o build/media-probe -framework CoreAudio -framework CoreMediaIO -framework AVFoundation && swiftc -O native/ClipboardProbe.swift -o build/clipboard-probe -framework AppKit",
    "package": "npm run build && npm run native:build && electron-builder --mac dmg zip --arm64",
    "package:dir": "npm run build && npm run native:build && electron-builder --mac dir --arm64",
    "verify": "npm run typecheck && npm run build && npm run native:build && npm test && npm run test:desktop && npm run test:workflows && npm run test:media",
    "test:desktop": "npm run test:shelf",
    "test:packaged": "EVERYTHING_EXECUTABLE=\"release/mac-arm64/Polka.app/Contents/MacOS/Polka\" tsx scripts/shelf-smoke.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.ts\" \"scripts/**/*.ts\" electron.vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.ts\" \"scripts/**/*.ts\" electron.vite.config.ts",
    "release": "node scripts/release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "test:workflows": "npm run test:clipboard && npm run test:clipboard:images && npm run test:clipboard:animation",
    "test:packaged:workflows": "EVERYTHING_EXECUTABLE=\"release/mac-arm64/Polka.app/Contents/MacOS/Polka\" npm run test:workflows",
    "test:auto-start": "npm run test:shelf",
    "test:launcher": "npm run test:shelf",
    "test:settings-shortcut": "npm run test:shelf",
    "test:packaged:settings-shortcut": "EVERYTHING_EXECUTABLE=\"release/mac-arm64/Polka.app/Contents/MacOS/Polka\" tsx scripts/shelf-smoke.ts",
    "test:packaged:launcher": "EVERYTHING_EXECUTABLE=\"release/mac-arm64/Polka.app/Contents/MacOS/Polka\" tsx scripts/shelf-smoke.ts",
    "test:packaged:auto-start": "EVERYTHING_EXECUTABLE=\"release/mac-arm64/Polka.app/Contents/MacOS/Polka\" tsx scripts/shelf-smoke.ts",
    "test:clipboard": "tsx scripts/clipboard-smoke.ts",
    "test:clipboard:paste": "tsx scripts/clipboard-paste-smoke.ts",
    "test:clipboard:images": "tsx scripts/clipboard-screenshot-smoke.ts",
    "test:clipboard:animation": "tsx scripts/clipboard-animation-smoke.ts",
    "test:shelf": "tsx scripts/shelf-smoke.ts",
    "test:media": "tsx scripts/media-indicator-smoke.ts"
  },
  "build": {
    "appId": "app.everything.desktop",
    "productName": "Polka",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/media-probe",
        "to": "media-probe"
      },
      {
        "from": "build/clipboard-probe",
        "to": "clipboard-probe"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "27.0",
      "identity": "-",
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "icon": "build/Everything.icon",
      "extendInfo": {
        "LSUIElement": true
      }
    }
  },
  "dependencies": {
    "@tabler/icons-react": "3.48.0",
    "electron-updater": "6.8.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "js-yaml": "4.3.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  }
}
