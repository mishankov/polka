{
  "name": "polka",
  "version": "0.1.15",
  "private": true,
  "description": "Приложения и история буфера обмена на полке macOS",
  "author": "Polka contributors",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "setup": "node scripts/setup-worktree.mjs",
    "predev": "node scripts/prepare-dev.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:desktop": "node scripts/test-desktop.mjs",
    "verify": "node scripts/verify.mjs",
    "package": "node scripts/package.mjs",
    "release": "node scripts/release/release.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" electron.vite.config.ts package.json tsconfig.json .prettierrc.json \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" electron.vite.config.ts package.json tsconfig.json .prettierrc.json \".github/**/*.yml\""
  },
  "build": {
    "appId": "app.everything.desktop",
    "productName": "Polka",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "docs/unicode-license.txt",
      "package.json",
      "!**/node_modules/electron-sparkle-updater/native/**"
    ],
    "extraResources": [
      {
        "from": "build/media-probe",
        "to": "media-probe"
      },
      {
        "from": "build/sync-discovery",
        "to": "sync-discovery"
      },
      {
        "from": "build/clipboard-probe",
        "to": "clipboard-probe"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "27.0",
      "identity": "-",
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "icon": "build/Everything.icon",
      "extendInfo": {
        "LSUIElement": true,
        "NSLocalNetworkUsageDescription": "Полка синхронизирует историю буфера обмена между связанными Mac в вашей локальной сети.",
        "NSBonjourServices": [
          "_everyclip._tcp"
        ]
      }
    },
    "npmRebuild": false
  },
  "dependencies": {
    "electron-sparkle-updater": "0.5.2",
    "zod": "4.6.5",
    "selfsigned": "5.5.0"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.3",
    "@playwright/test": "1.63.0",
    "@tabler/icons-react": "3.48.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "esbuild": "0.28.2",
    "fast-xml-parser": "5.11.2",
    "js-yaml": "4.3.2",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  },
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.16.0"
}
