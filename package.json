{
  "name": "everything-app",
  "version": "0.1.15",
  "private": true,
  "description": "Локальная платформа персональных приложений",
  "author": "Everything App contributors",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "npm run build:extensions && electron-vite dev",
    "build": "electron-vite build && tsx scripts/build-extension-runtime.ts",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "native:build": "swiftc -O native/MediaProbe.swift -o build/media-probe -framework CoreAudio -framework CoreMediaIO -framework AVFoundation",
    "package": "npm run build && npm run native:build && electron-builder --mac dmg zip --arm64",
    "package:dir": "npm run build && npm run native:build && electron-builder --mac dir --arm64",
    "verify": "npm run typecheck && npm run build && npm test && npm run test:desktop && npm run test:workflows",
    "test:desktop": "tsx scripts/desktop-smoke.ts",
    "test:packaged": "EVERYTHING_EXECUTABLE=\"release/mac-arm64/Everything App.app/Contents/MacOS/Everything App\" tsx scripts/desktop-smoke.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.ts\" \"scripts/**/*.ts\" electron.vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.ts\" \"scripts/**/*.ts\" electron.vite.config.ts",
    "release": "node scripts/release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "test:documents": "tsx scripts/document-workflows-smoke.ts",
    "test:extensions": "tsx scripts/extensions-smoke.ts",
    "test:packages": "tsx scripts/package-workflows-smoke.ts",
    "test:workflows": "npm run test:documents && npm run test:formats && npm run test:extensions && npm run test:packages && npm run test:provider && npm run test:streaming && npm run test:window-close && npm run test:auto-start && npm run test:tray && npm run test:window-settings",
    "test:packaged:workflows": "EVERYTHING_EXECUTABLE=\"release/mac-arm64/Everything App.app/Contents/MacOS/Everything App\" npm run test:workflows",
    "test:provider": "tsx scripts/provider-smoke.ts",
    "test:packaged:provider": "EVERYTHING_EXECUTABLE=\"release/mac-arm64/Everything App.app/Contents/MacOS/Everything App\" tsx scripts/provider-smoke.ts",
    "test:streaming": "tsx scripts/assistant-streaming-smoke.ts",
    "test:packaged:streaming": "EVERYTHING_EXECUTABLE=\"release/mac-arm64/Everything App.app/Contents/MacOS/Everything App\" tsx scripts/assistant-streaming-smoke.ts",
    "test:window-close": "tsx scripts/window-close-smoke.ts",
    "test:packaged:window-close": "EVERYTHING_EXECUTABLE=\"release/mac-arm64/Everything App.app/Contents/MacOS/Everything App\" tsx scripts/window-close-smoke.ts",
    "test:auto-start": "tsx scripts/auto-start-smoke.ts",
    "test:tray": "tsx scripts/tray-apps-smoke.ts",
    "test:window-settings": "tsx scripts/overlay-window-smoke.ts",
    "test:packaged:auto-start": "EVERYTHING_EXECUTABLE=\"release/mac-arm64/Everything App.app/Contents/MacOS/Everything App\" tsx scripts/auto-start-smoke.ts",
    "build:extensions": "tsx scripts/build-extension-runtime.ts",
    "test:formats": "tsx scripts/formats-smoke.ts"
  },
  "build": {
    "appId": "app.everything.desktop",
    "productName": "Everything App",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/media-probe",
        "to": "media-probe"
      }
    ],
    "asarUnpack": [
      "**/*.wasm",
      "**/esbuild/**",
      "**/@esbuild/**",
      "**/node_modules/react/**",
      "**/node_modules/react-dom/**",
      "**/node_modules/scheduler/**"
    ],
    "fileAssociations": [
      {
        "ext": "everyapp",
        "name": "Everything App Package",
        "role": "Editor",
        "mimeType": "application/vnd.everything-app"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "27.0",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@mantine/core": "9.6.3",
    "@mantine/hooks": "9.6.3",
    "@mantine/notifications": "9.6.3",
    "@tabler/icons-react": "3.48.0",
    "@uiw/react-codemirror": "4.25.12",
    "electron-updater": "6.8.9",
    "esbuild": "0.28.2",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "iconv-lite": "0.7.3",
    "quickjs-emscripten": "0.32.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "js-yaml": "4.3.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  }
}
