# Do not commit credentials. Supply these through your CI secret store.
# Persistent self-signed release identity (no Apple account needed):
# POLKA_SIGNING_P12=/absolute/secure/path/identity.p12
# POLKA_SIGNING_PASSWORD=...
# POLKA_SIGNING_CERT_SHA1=40_HEX_DIGITS_FROM_FINGERPRINT_FILE
# SPARKLE_PUBLIC_KEY=...
# SPARKLE_PRIVATE_KEY=...
# GH_TOKEN=...

# RELEASE_REPOSITORY=your-owner/your-repository
# RELEASE_TAG=vX.Y.Z
