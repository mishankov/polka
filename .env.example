# Do not commit credentials. Supply these through your CI secret store.
# CSC_LINK=/secure/path/Developer-ID.p12
# CSC_KEY_PASSWORD=...
# APPLE_ID=owner@example.com
# APPLE_APP_SPECIFIC_PASSWORD=...
# APPLE_TEAM_ID=...
# GH_TOKEN=...

# RELEASE_REPOSITORY=your-owner/your-repository
# Alternative notarization credentials:
# APPLE_API_KEY=/secure/path/AuthKey.p8
# APPLE_API_KEY_ID=...
# APPLE_API_ISSUER=...
