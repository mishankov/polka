+// Ordinary quit must discard staging instead of consenting to an update.
+Napi::Value CancelPendingUpdate(const Napi::CallbackInfo &info) {
+  RunOnMain(^{
+    if (g_userDriver == nil) return;
+    g_userDriver.installWhenReady = NO;
+    g_userDriver.installOnQuitWhenReady = NO;
+    void (^reply)(SPUUserUpdateChoice) = g_userDriver.readyToInstallReply;
+    void (^cancel)(void) = g_userDriver.cancelUpdate;
+    g_userDriver.readyToInstallReply = nil;
+    g_userDriver.cancelUpdate = nil;
+    if (reply != nil) reply(SPUUserUpdateChoiceSkip);
+    else if (cancel != nil) cancel();
+  });
+  return info.Env().Undefined();
+}
